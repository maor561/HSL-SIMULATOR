# מסד נתונים — Neon Postgres (Vercel Marketplace → Neon). מחרוזת החיבור המאגרת (pooled).
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# סיסמת הכניסה למערכת הניהול (/admin)
ADMIN_PASSWORD="change-me"

# מפתח לחתימת עוגיית הסשן של האדמין — מחרוזת אקראית ארוכה
ADMIN_SESSION_SECRET="generate-a-long-random-string"
